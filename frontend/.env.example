# Development
VITE_API_URL=http://localhost:3001/api

# Production (set in Azure Static Web Apps configuration)
# VITE_API_URL=https://yoursite.com/api

# Supabase Auth (VITE_ prefix required — Vite only exposes VITE_-prefixed vars)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Chat API (AWS API Gateway)
VITE_CHAT_API_URL=https://your-api-gateway.execute-api.us-east-1.amazonaws.com/v1