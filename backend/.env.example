# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=https://YOUR-STATIC-WEB-APP.azurestaticapps.net

# Database
# For Raspberry Pi, use connection pooling to optimize resource usage:
# - connection_limit=5 to 10 (depending on available RAM)
# - pool_timeout=20 (seconds to wait for available connection)
DATABASE_URL=postgresql://picai_user:your_password@localhost:5432/picai?connection_limit=5&pool_timeout=20

# Supabase Auth
# SUPABASE_URL: Your Supabase project URL (Settings → API → Project URL)
# SUPABASE_SECRET_KEY: Service role key for server-side auth verification (Settings → API → API Keys → secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=eyJ...your-service-role-key...

# Azure Computer Vision
AZURE_VISION_KEY=your-azure-vision-key-here
AZURE_VISION_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/

# AWS Rekognition (uses IAM Roles Anywhere for authentication)
# AWS_PROFILE references the profile configured in ~/.aws/config with credential_process
# See docs/AWS_REKOGNITION_SETUP.md for setup instructions
AWS_REGION=us-east-1
AWS_PROFILE=picai-rekognition

# File Storage
UPLOAD_DIR=/home/pi/picai/storage/originals
THUMBNAIL_DIR=/home/pi/picai/storage/thumbnails
MAX_FILE_SIZE=26214400

# SendGrid Email Service (Optional)
# SENDGRID_API_KEY=SG.your-sendgrid-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Cloudflare (for reference)
# Tunnel URL: https://api.yourdomain.com
